NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical web-admin origin used for password recovery links.
# Set this to the public site URL in production (for example https://farm.example.com).
SITE_URL=http://localhost:3000

# Server-only. Never expose this with NEXT_PUBLIC_.
# Required for System Administrator user creation.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Required only if Rovie is connected to an external AI provider.
OPENAI_API_KEY=
